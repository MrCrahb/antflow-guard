# ==============================================================================
# AntFlow Guard — Environment Configuration
# ==============================================================================

# Database Connection (AsyncPG format required for async SQLAlchemy)
#
# Option A: Free Serverless Cloud Postgres (Neon / Supabase):
# 1. Create a project at https://neon.tech (instant free tier, no credit card)
# 2. Replace "postgresql://" with "postgresql+asyncpg://" and append "?ssl=require"
# Example:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:secret@ep-cool-sample.us-east-2.aws.neon.tech/neondb?ssl=require
#
# Option B: Local Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://ant_dev:ant_dev_password@localhost:5432/antflow_db
#
# Option C: Local Async SQLite (Automated Local Unit Testing fallback):
DATABASE_URL=sqlite+aiosqlite:///./antflow.db

# Server Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CI / AI Triage (Gemini Flash)
GEMINI_API_KEY=
